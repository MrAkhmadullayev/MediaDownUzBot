APP_ENV=development
BOT_TOKEN=123456789:replace_with_real_bot_token
TELEGRAM_API_ID=replace_with_api_id_from_my_telegram_org
TELEGRAM_API_HASH=replace_with_api_hash_from_my_telegram_org
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_LOCAL_MODE=true
ADMIN_TELEGRAM_IDS=[123456789]
ADMIN_BASE_URL=http://localhost:8080
ALLOWED_HOSTS=["localhost","127.0.0.1","admin","nginx"]
DATABASE_URL=postgresql+asyncpg://mediadown:change_me@postgres:5432/mediadown
ALEMBIC_DATABASE_URL=postgresql+psycopg://mediadown:change_me@postgres:5432/mediadown
POSTGRES_DB=mediadown
POSTGRES_USER=mediadown
POSTGRES_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0
FIELD_ENCRYPTION_KEY=replace_with_fernet_key
ADMIN_SESSION_TTL_HOURS=12
ADMIN_LOGIN_TTL_SECONDS=300
COOKIE_SECURE=false
VIDEOS_DIR=/app/videos
TELEGRAM_UPLOAD_LIMIT_MB=2000
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=3600
MAX_DOWNLOAD_SECONDS=3600
MAX_VIDEO_HEIGHT=2160
WORKER_CONCURRENCY=4
MEDIA_METADATA_CACHE_TTL_SECONDS=86400
MEDIA_DEDUP_RETRY_SECONDS=3
WORKER_DNS_PRIMARY=1.1.1.1
WORKER_DNS_SECONDARY=8.8.8.8
LOG_LEVEL=INFO
YTDLP_COOKIES_FILE=
YTDLP_POT_PROVIDER_URL=http://youtube-pot-provider:4416
YTDLP_PROXY_URL=
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_PROXY_URL=
